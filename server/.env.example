# DEMO ONLY — do not reuse these values for anything real.
DATABASE_URL="postgresql://parametric:parametric_demo_only@localhost:55432/parametric_demo"
# Direct (non-pooled) connection used only for `prisma migrate deploy`.
# Same value as DATABASE_URL locally; on Neon/Vercel use the "unpooled"
# connection string (no "-pooler" in the hostname) — migrations need a
# direct session, the pooled connection can't reliably take the advisory
# lock migrate uses and times out (P1002).
DIRECT_URL="postgresql://parametric:parametric_demo_only@localhost:55432/parametric_demo"
JWT_SECRET="demo-only-jwt-secret-change-me"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Only needed when deployed (Vercel sets this automatically once Blob
# storage is enabled on the project). Local dev falls back to writing
# generated certificates/scans to server/storage/ on disk when unset.
# BLOB_READ_WRITE_TOKEN=
